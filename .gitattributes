# Auto detect text files and perform LF normalization
* text=auto

# Go
*.go text diff=golang
go.mod text diff=golang
go.sum text

# Shell scripts
*.sh text eol=lf

# Makefiles
Makefile text eol=lf

# Markdown
*.md text diff=markdown

# YAML
*.yml text
*.yaml text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# TLS (never commit real certs, but ignore patterns)
*.pem binary
*.key binary
